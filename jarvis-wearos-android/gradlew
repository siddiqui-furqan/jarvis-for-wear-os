#!/bin/sh
#
# Gradle startup script for POSIX — J.A.R.V.I.S. for Wear OS (V6)
#
APP_HOME=$( cd "${0%/*}" && pwd -P ) || exit
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -n "$JAVA_HOME" ] ; then
    JAVACMD=$JAVA_HOME/bin/java
else
    JAVACMD=java
fi

if [ ! -f "$CLASSPATH" ]; then
    echo "Gradle wrapper JAR not cached locally. Falling back to system 'gradle' or Android Studio embedded Gradle..."
    if command -v gradle >/dev/null 2>&1; then
        exec gradle "$@"
    else
        echo "ERROR: gradle-wrapper.jar is missing and system 'gradle' was not found. Open this project in Android Studio to sync Gradle automatically, or run 'gradle wrapper'."
        exit 1
    fi
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
